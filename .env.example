# Copy this file to .env and fill in real values before running `docker compose up`.
# docker-compose.yml reads these exact variable names.

DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=change_me

# Hibernate ddl-auto strategy for the backend (update/validate/none/create-drop)
DDL_AUTO=update

# HS256 secret used to sign JWTs — generate a real random value for anything beyond local dev
JWT_SECRET_KEY=change_me_in_production

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
